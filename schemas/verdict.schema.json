{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://united-software-platform/struct-linter/verdict.schema.json",
  "title": "Вердикт валидации структуры (verdict)",
  "description": "Замкнутая схема вердикта: статус, применённый эталон, классифицированные нарушения либо ошибка вызова.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "violations"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "status": { "type": "string", "enum": ["ok", "violations", "error"] },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "language"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "minLength": 1 }
      }
    },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "path", "rule", "reason"],
        "properties": {
          "code": {
            "type": "string",
            "enum": ["MISSING_REQUIRED", "FORBIDDEN_PRESENT", "NAMING_VIOLATION", "LAYER_PATH_VIOLATION"]
          },
          "path": { "type": "string" },
          "rule": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  }
}
